#LLM PROVIDER SELECTION
LLM_PROVIDER=

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Anthropic 
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

#OpenAI 
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

#shared LLM settings
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3


#TOOL PROVIDERS  
WEATHER_PROVIDER=mock
IMAGE_PROVIDER=mock
SEARCH_PROVIDER=mock

# Only read when the matching provider above is set to "live".
OPENWEATHER_API_KEY=
UNSPLASH_ACCESS_KEY=
TAVILY_API_KEY=


MOCK_WEATHER_LATENCY_MS=900
MOCK_IMAGE_LATENCY_MS=1100
MOCK_SEARCH_LATENCY_MS=800
MOCK_LATENCY_JITTER=0.15


IMAGE_FALLBACK_MODE=auto

# Per-attempt timeout and attempt budget for every tool call.
TOOL_TIMEOUT_SECONDS=12
TOOL_MAX_ATTEMPTS=3

# Demo switches for the graceful-degradation rubric line
FORCE_WEATHER_FAILURE=false
WEATHER_FAILURE_MODE=server_error
FORCE_IMAGE_FAILURE=false
IMAGE_FAILURE_MODE=server_error

#RETRIEVAL / ROUTING
EMBEDDING_PROVIDER=hashed        
EMBEDDING_DIM=512
VECTOR_STORE_DIR=data/vector_store
VECTOR_STORE_BACKEND=faiss        
RETRIEVAL_TOP_K=4

# Cosine-similarity gate for "do I have documents about this city?"
ROUTER_SIMILARITY_THRESHOLD=0.07

#MEMORY / CHECKPOINTING
CHECKPOINTER=memory                # memory | sqlite
CHECKPOINT_DB_PATH=data/checkpoints.sqlite

# 5. RUNTIME
LOG_LEVEL=INFO
ENABLE_CACHE=true
CACHE_TTL_SECONDS=900
