# =============================================================================
#  Multi-Modal Travel Assistant — environment configuration
#  Copy to .env:   Windows: copy .env.example .env   |   Unix: cp .env.example .env
#
#  THE APP RUNS END-TO-END WITH ZERO API KEYS.
#  Leave every key blank and everything below stays on the deterministic mock
#  providers: MockLLM, mock weather, mock images, mock web search. Every test
#  and the full Streamlit demo pass in that state.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. LLM PROVIDER SELECTION
# -----------------------------------------------------------------------------
# Auto-detection order (first key found wins):
#     1. GROQ_API_KEY      -> groq       (DEFAULT — fast, generous free tier)
#     2. ANTHROPIC_API_KEY -> anthropic  (spec-named provider, fully implemented)
#     3. OPENAI_API_KEY    -> openai     (spec-named provider, fully implemented)
#     4. no keys           -> mock       (deterministic, offline)
#
# LLM_PROVIDER overrides auto-detection entirely. Set it to force a provider
# even when other keys are present.
# Accepted values: groq | anthropic | openai | mock
LLM_PROVIDER=

# --- Groq (default demo driver) — https://console.groq.com/keys ---------------
GROQ_API_KEY=
# Must be a currently-available Groq model that supports tool calling.
# On startup GroqLLM queries /v1/models and warns (then auto-falls-back) if this
# id has been deprecated, so a Groq model retirement never hard-fails the demo.
GROQ_MODEL=openai/gpt-oss-120b

# --- Anthropic — https://console.anthropic.com/settings/keys -----------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- OpenAI — https://platform.openai.com/api-keys ---------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# --- shared LLM settings -----------------------------------------------------
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3

# -----------------------------------------------------------------------------
# 2. TOOL PROVIDERS  (live | mock)
# -----------------------------------------------------------------------------
# Each tool is independently switchable. This is the one-line change that swaps
# a mock for a real API — no application code is touched.
WEATHER_PROVIDER=mock
IMAGE_PROVIDER=mock
SEARCH_PROVIDER=mock

# Only read when the matching provider above is set to "live".
OPENWEATHER_API_KEY=
UNSPLASH_ACCESS_KEY=
TAVILY_API_KEY=

# Mock realism knobs — the mocks sleep to simulate real network latency, which
# is what makes the parallel fan-out speed-up measurable rather than theoretical.
MOCK_LATENCY_MIN_MS=600
MOCK_LATENCY_MAX_MS=1400

# Demo switch for the graceful-degradation rubric line. When true the weather
# tool always raises; the app must still render summary + images + a warning.
FORCE_WEATHER_FAILURE=false

# -----------------------------------------------------------------------------
# 3. RETRIEVAL / ROUTING
# -----------------------------------------------------------------------------
EMBEDDING_PROVIDER=hashed          # hashed | openai   (hashed = offline default)
VECTOR_STORE_DIR=data/vector_store
VECTOR_STORE_BACKEND=faiss         # faiss | numpy     (numpy = automatic fallback)
# Cosine-similarity gate for "do I know this city?". Below this the graph routes
# to web search instead. The value is justified with numbers by evals/run_eval.py.
ROUTER_SIMILARITY_THRESHOLD=0.55

# -----------------------------------------------------------------------------
# 4. MEMORY / CHECKPOINTING
# -----------------------------------------------------------------------------
CHECKPOINTER=memory                # memory | sqlite
CHECKPOINT_DB_PATH=data/checkpoints.sqlite

# -----------------------------------------------------------------------------
# 5. RUNTIME
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
ENABLE_CACHE=true
CACHE_TTL_SECONDS=900
